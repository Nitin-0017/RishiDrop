# CampusDrop Environment Configuration Example
NODE_ENV=development
PORT=5001
CLIENT_URL=https://rishi-drop.vercel.app

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/campusdrop?schema=public

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
